const admin = require("firebase-admin");

const corsHeaders = {
  "Content-Type": "application/json",
  "Cache-Control": "no-store",
};

function respond(statusCode, body) {
  return {
    statusCode,
    headers: corsHeaders,
    body: JSON.stringify(body),
  };
}

function getFirebaseAdmin() {
  if (!admin.apps.length) {
    const rawCredentials = process.env.FIREBASE_SERVICE_ACCOUNT;

    if (!rawCredentials) {
      throw new Error("Credenciais do Firebase Admin ausentes no Netlify");
    }

    // Garante que as quebras de linha da chave privada não quebrem o JSON
    const formattedCredentials = rawCredentials.replace(/\\n/g, '\n');
    const serviceAccount = JSON.parse(formattedCredentials);

    admin.initializeApp({
      credential: admin.credential.cert(serviceAccount),
    });
  }

  return admin;
}

exports.handler = async (event) => {
  if (event.httpMethod !== "POST") {
    return respond(405, { error: "Metodo nao permitido" });
  }

  try {
    const firebaseAdmin = getFirebaseAdmin();
    const expectedAdminUid = process.env.ADMIN_UID;

    if (!expectedAdminUid) {
      return respond(500, { error: "UID do Admin ausente" });
    }

    const authorization = event.headers.authorization || "";
    const match = authorization.match(/^Bearer\s+(.+)$/i);

    if (!match) {
      return respond(401, { error: "Token ausente" });
    }

    const decodedToken = await firebaseAdmin
      .auth()
      .verifyIdToken(match[1], true);

    if (decodedToken.uid !== expectedAdminUid) {
      return respond(403, { error: "Acesso negado", isAdmin: false });
    }

    // A RESPOSTA CORRETA QUE O NOSSO FRONTEND ESPERA:
    return respond(200, {
      ok: true,
      authorized: true,
      isAdmin: true 
    });
    
  } catch (error) {
    console.error("Falha na autenticacao do admin:", error.message);

    return respond(401, {
      error: "Falha na autenticacao",
    });
  }
};
